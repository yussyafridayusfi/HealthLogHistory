# Copy to .env. .env is gitignored.

# --- Runtime ---------------------------------------------------------------
PORT=8787

# Safe default: parse and log the row, but do not call Google Sheets.
# Set to false once the parser output looks right.
DRY_RUN=true

# Set to false to run the HTTP ingest endpoint without connecting to WhatsApp.
WHATSAPP_ENABLED=true

# --- Timezone --------------------------------------------------------------
# Minutes east of UTC used to interpret "time check". 420 = UTC+7 (Asia/Jakarta).
TZ_OFFSET_MINUTES=420

# --- WhatsApp --------------------------------------------------------------
AUTH_DIR=.state/baileys-auth

# Comma-separated wa ids allowed to log readings, e.g. 6281234567890.
# Empty = accept every inbound chat (fine for a personal setup, risky otherwise).
ALLOW_FROM=

# Reply to the sender with the parsed row so mistakes are visible immediately.
REPLY_ENABLED=true

# --- Google Sheets ---------------------------------------------------------
# Leave SHEET_ID empty to keep DRY_RUN behaviour regardless of the flag above.
SHEET_ID=
SHEET_TAB=Log

# Either an absolute path to the service-account key file...
GOOGLE_SERVICE_ACCOUNT_JSON=secret/service-account.json
# ...or the raw JSON of the key on a single line. Share the spreadsheet with
# the service account's client_email, otherwise append fails with 403.
